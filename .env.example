# Environment Variables Template
# Copy to .env or .dev.vars for local development

# Admin password (required)
# Set via: npx wrangler secret put ADMIN_PASSWORD --env production
ADMIN_PASSWORD=your-secure-password-here

# Cloudflare Account ID (required for deployment)
# Find at: https://dash.cloudflare.com/ (right sidebar)
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Cloudflare API Token (required for wrangler)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Account > Cloudflare Pages (Edit), D1 (Edit), R2 (Edit)
CLOUDFLARE_API_TOKEN=your-api-token
